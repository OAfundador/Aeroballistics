# Scan of the report (30 MB) and cache of rotated pages: kept out of the repository
sources/jp2/
sources/cache/

# Working crops generated by scripts/reading/crop.py
**/crops/

__pycache__/
.pytest_cache/

# Results generated by the scripts (python scripts/...): can be regenerated
output/

# Scratch area of tasks A-F (whatever is usable is moved to the right place)
trabalho/

# Internal documents of the work sessions (kept only in the local folder)
docs/CONTEXTO_CLAUDE_CODE.md
docs/AVALIACAO_FASE8.md

# Reference PDFs (available from DTIC)
sources/*.pdf

# packaging (pip install -e .)
*.egg-info/
build/
dist/

# local Claude Code state
.claude/

# Private material (literal copies of the report): stays on the local machine only
sources/private/
